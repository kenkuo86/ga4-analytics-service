{
  "additionalProperties": false,
  "description": "Accept only already sanitized text, never raw requests or tool results.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_time": {
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    },
    "interaction_id": {
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Interaction Id",
      "type": "string"
    },
    "event_name": {
      "const": "analytics_request_summary",
      "default": "analytics_request_summary",
      "title": "Event Name",
      "type": "string"
    },
    "request_summary": {
      "maxLength": 500,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Request Summary",
      "type": "string"
    },
    "request_summary_source": {
      "enum": [
        "host_model_generated",
        "server_generated",
        "client_generated",
        "user_input"
      ],
      "title": "Request Summary Source",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_time",
    "interaction_id",
    "event_name",
    "request_summary",
    "request_summary_source"
  ],
  "title": "SummaryAttachment",
  "type": "object"
}
