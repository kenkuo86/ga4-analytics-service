# Current/private mode: Cloud Run IAM validates Google identity tokens.
AUTH_MODE=cloud-run-iam

# Shared GA4 data-query policy. Byte values use decimal GB.
GA4_QUERY_MAX_DAYS=90
GA4_QUERY_EARLIEST_DATE=2020-10-14
GA4_QUERY_MAX_BYTES_PER_JOB=2000000000
GA4_QUERY_MAX_BYTES_PER_REQUEST=10000000000
GA4_QUERY_JOB_TIMEOUT_MS=60000
GA4_QUERY_TIME_ZONE=Asia/Taipei

# Optional query-job and billing project. Blank or unset falls back to ADC detection.
BIGQUERY_BILLING_PROJECT=ga4-reports-dev

# Claude Web PoC mode. Do not place real secret values in this file.
# AUTH_MODE=oauth
# OAUTH_ISSUER_URL=https://ga4-analytics-service-398991472921.asia-east1.run.app
# MCP_PUBLIC_URL=https://ga4-analytics-service-398991472921.asia-east1.run.app/mcp
# OAUTH_ALLOWED_EMAILS=allowed-user@example.com

# Pre-registered public OAuth client entered in Claude Custom Connector.
# PKCE protects the authorization-code exchange; no MCP client secret is used.
# MCP_OAUTH_CLIENT_ID=generated-client-id

# Google Web OAuth client used only to authenticate the human user.
# GOOGLE_OAUTH_CLIENT_ID=google-web-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=from-secret-manager

# RSA private key used to sign MCP access tokens. Preserve PEM newlines or use \n.
# MCP_TOKEN_SIGNING_PRIVATE_KEY=from-secret-manager
# MCP_TOKEN_SIGNING_KEY_ID=ga4-mcp-poc-1
